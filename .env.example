# PostgreSQL（密码必须修改；其余两项可保持默认）
POSTGRES_DB=image_rating
POSTGRES_USER=image_rating
POSTGRES_PASSWORD=change-me

# 可选：覆盖 Compose 默认的宿主机数据目录和 Web 端口
RATING_DATA_DIR=/data/sunwenxiu/rating
WEB_PORT=8080

# 可选：API 单实例数据库连接与超时配置
# 100 人规模建议保持 PG_POOL_MAX=24
PG_POOL_MAX=24
PG_STATEMENT_TIMEOUT_MS=15000
PG_LOCK_TIMEOUT_MS=2000

# 可选：完整覆盖 Compose 自动生成的 PostgreSQL 连接串
# DATABASE_URL=postgresql://image_rating:change-me@postgres:5432/image_rating

# 可选：仅通过 HTTPS 访问时开启安全 Cookie
# COOKIE_SECURE=true

# 可选：跨域前端地址；不需要跨域时留空
# CORS_ORIGIN=https://rating.example.com

# 可选：上传与图片处理限制（单位：字节；不设置则使用程序默认值）
# MAX_ZIP_BYTES=1073741824
# MAX_ARCHIVE_ENTRIES=50000
# MAX_ARCHIVE_UNCOMPRESSED_BYTES=21474836480
# MAX_IMAGE_UNCOMPRESSED_BYTES=134217728
# MAX_CHUNK_COUNT=10000
# IMAGE_IMPORT_CONCURRENCY=4
# IMAGE_THUMBNAIL_SIZE=640
# IMAGE_THUMBNAIL_QUALITY=76
# IMAGE_THUMBNAIL_EFFORT=2
